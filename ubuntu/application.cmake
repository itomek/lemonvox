pkg_check_modules(ADWAITA REQUIRED IMPORTED_TARGET libadwaita-1>=1.5 gtk4>=4.14)
set(LEMONVOX_VERSION "0.2.0" CACHE STRING "LemonVox application version")
execute_process(COMMAND git -C "${LEMONVOX_ROOT}" rev-parse --short HEAD OUTPUT_VARIABLE LEMONVOX_BUILD OUTPUT_STRIP_TRAILING_WHITESPACE)
execute_process(COMMAND git -C "${LEMONVOX_ROOT}" status --porcelain OUTPUT_VARIABLE LEMONVOX_DIRTY OUTPUT_STRIP_TRAILING_WHITESPACE)
if(LEMONVOX_DIRTY)
    string(APPEND LEMONVOX_BUILD "-dirty")
endif()
add_library(lemonvox_ubuntu_settings STATIC settings.cpp diagnostics.cpp)
target_compile_features(lemonvox_ubuntu_settings PUBLIC cxx_std_17)
target_compile_options(lemonvox_ubuntu_settings PRIVATE -Wall -Wextra -Werror)
target_compile_definitions(lemonvox_ubuntu_settings PUBLIC LEMONVOX_VERSION="${LEMONVOX_VERSION}" LEMONVOX_BUILD="${LEMONVOX_BUILD}")
target_link_libraries(lemonvox_ubuntu_settings PUBLIC lemonvox_ubuntu_adapters PkgConfig::ADWAITA)
add_executable(lemonvox main.cpp)
target_compile_options(lemonvox PRIVATE -Wall -Wextra -Werror)
target_link_libraries(lemonvox PRIVATE lemonvox_ubuntu_settings)
install(TARGETS lemonvox RUNTIME DESTINATION bin)
if(BUILD_TESTING)
    add_test(NAME lemonvox_version_test COMMAND "${CMAKE_COMMAND}" -E env --unset=DISPLAY --unset=WAYLAND_DISPLAY $<TARGET_FILE:lemonvox> --version)
    foreach(test settings diagnostics)
        add_executable(lemonvox_${test}_test tests/${test}_test.cpp)
        target_compile_options(lemonvox_${test}_test PRIVATE -UNDEBUG -Wall -Wextra -Werror)
        target_link_libraries(lemonvox_${test}_test PRIVATE lemonvox_ubuntu_settings)
        add_test(NAME lemonvox_${test}_test COMMAND lemonvox_${test}_test)
    endforeach()
    add_executable(lemonvox_workflow_native_test tests/workflow_native_test.cpp)
    target_compile_options(lemonvox_workflow_native_test PRIVATE -UNDEBUG -Wall -Wextra -Werror)
    target_link_libraries(lemonvox_workflow_native_test PRIVATE lemonvox_ubuntu_adapters)
    add_test(NAME lemonvox_workflow_native_test COMMAND lemonvox_workflow_native_test)
    set_tests_properties(lemonvox_workflow_native_test PROPERTIES TIMEOUT 30)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/tests/packaging_test.py")
        add_test(NAME lemonvox_packaging_test COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/tests/packaging_test.py")
    endif()
endif()
if(BUILD_TESTING)
    add_executable(lemonvox_workflow_audio_test tests/workflow_audio_test.cpp)
    target_compile_options(lemonvox_workflow_audio_test PRIVATE -UNDEBUG -Wall -Wextra -Werror)
    target_link_libraries(lemonvox_workflow_audio_test PRIVATE lemonvox_ubuntu_adapters)
    # Deliberately not in CTest: requires an explicitly selected virtual device
    # and a running local Lemonade with downloaded ASR/cleanup models.
endif()
if(BUILD_TESTING)
    add_executable(lemonvox_settings_ui_test tests/settings_ui_test.cpp)
    target_compile_options(lemonvox_settings_ui_test PRIVATE -UNDEBUG -Wall -Wextra -Werror)
    target_link_libraries(lemonvox_settings_ui_test PRIVATE lemonvox_ubuntu_settings)
endif()
if(BUILD_TESTING)
    find_program(GJS_EXECUTABLE gjs REQUIRED)
    find_program(DBUS_RUN_SESSION_EXECUTABLE dbus-run-session REQUIRED)
    add_test(NAME lemonvox_extension_policy_test COMMAND "${GJS_EXECUTABLE}" -m "${CMAKE_CURRENT_LIST_DIR}/tests/extension_policy_test.mjs")
    add_test(NAME lemonvox_extension_dbus_test COMMAND "${DBUS_RUN_SESSION_EXECUTABLE}" -- "${GJS_EXECUTABLE}" -m "${CMAKE_CURRENT_LIST_DIR}/tests/extension_native_dbus_test.mjs")
    add_test(NAME lemonvox_extension_contract_test COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/tests/extension_contract_test.py")
    set_tests_properties(lemonvox_extension_dbus_test PROPERTIES TIMEOUT 20)
endif()
