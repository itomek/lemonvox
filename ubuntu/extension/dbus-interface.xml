<!DOCTYPE node PUBLIC
  "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="com.itomek.LemonVox">
    <method name="Toggle"/>
    <method name="Stop"/>
    <method name="Cancel"/>
    <method name="ShowSettings"/>
    <method name="ClearResult"/>
    <method name="Quit"/>
    <property name="State" type="s" access="read"/>
    <property name="Message" type="s" access="read"/>
    <property name="Result" type="s" access="read"/>
    <property name="Palette" type="s" access="read"/>
    <property name="Error" type="b" access="read"/>
  </interface>
</node>
