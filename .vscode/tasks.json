{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build LemonVox",
            "detail": "Build the native app for this OS into .build.",
            "type": "process",
            "command": "/bin/bash",
            "args": [
                "-c",
                "cmake -S \"$0/ubuntu\" -B \"$0/.build/ubuntu\" -DCMAKE_BUILD_TYPE=Debug && cmake --build \"$0/.build/ubuntu\" --parallel",
                "${workspaceFolder}"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\windows\\scripts\\dev.ps1"
                ]
            },
            "osx": {
                "command": "/bin/bash",
                "args": [
                    "-c",
                    "pkill -f \"$0/.build/LemonVox.app/Contents/MacOS/\"; exec bash \"$0/scripts/build.sh\"",
                    "${workspaceFolder}"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ],
            "inAgents": true
        },
        {
            "label": "Run LemonVox",
            "detail": "Build (Windows: windows/scripts/dev.ps1 -Run), then launch LemonVox from .build. The task runs until the app quits.",
            "type": "process",
            "command": "/bin/bash",
            "args": [
                "-c",
                "cmake -S \"$0/ubuntu\" -B \"$0/.build/ubuntu\" -DCMAKE_BUILD_TYPE=Debug && cmake --build \"$0/.build/ubuntu\" --parallel && exec \"$0/.build/ubuntu/lemonvox\" --settings",
                "${workspaceFolder}"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\windows\\scripts\\dev.ps1",
                    "-Run"
                ]
            },
            "osx": {
                "command": "/bin/bash",
                "args": [
                    "-c",
                    "pkill -f \"$0/.build/LemonVox.app/Contents/MacOS/\"; bash \"$0/scripts/build.sh\" && exec /usr/bin/open -n -W \"$0/.build/LemonVox.app\"",
                    "${workspaceFolder}"
                ]
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "inAgents": true
        }
    ]
}
